library(tidyverse)
library(stringdist)
library(naniar)
load("./precleaned.RData")
data <- precleaned_data
parameter <- precleaned_parameter
procedure <- precleaned_procedure
disease <- precleaned_disease
bespoke <- precleaned_bespoke
#checking NAs and duplicates
sum(is.na(data$analysis_id))
sum(duplicated(data$analysis_id[!is.na(data$analysis_id)]))
#duplicates will be handled on step 2, after all typos and data format is cleaned
#checking if values follow notation of "an" + numbers:
all(grepl("^an[0-9]{10}$", data$analysis_id[!is.na(data$analysis_id)]))
#TRUE, all values followed the convention, no cleaning needed
#checking missing gene IDs
sum(is.na(data$gene_accession_id))
#checking unexpected ID format
sum(!grepl("^MGI:[0-9]+$", data$gene_accession_id))
#checking unique gene IDs
length(unique(data$gene_accession_id))
#checking IDs against disease reference
length(setdiff(unique(data$gene_accession_id), disease$mgi_id))
#no corrections needed
##Importing the official MGI gene list
readLines("./References/MGI_genesymbol_ref.rpt", n = 2)
ref_genesymbol <- read.delim("./References/MGI_genesymbol_ref.rpt", header = TRUE, check.names = FALSE)
#extracting only the column of gene accession id and gene symbol name
ref_genesymbol <- ref_genesymbol %>%
select("MGI Accession ID", "Marker Symbol")
#! eval:FALSE
if (FALSE) {
##cleaning the data
#remove special characters
data$gene_symbol<- str_remove_all(data$gene_symbol, "[!@#$%^&*+_.]")
#check any remaining mismatch with the conventional gene symbol
unique(data$gene_symbol[
!grepl("^[A-Z][A-Za-z0-9]*$", data$gene_symbol) &
!is.na(data$gene_symbol)
])
#genes like 1700029H14Rik are acceptable according to guideline
# no appropiate use of () found, so we remove
data$gene_symbol<- str_remove_all(data$gene_symbol, "[()]")
# hyphen as initial letter of gene symbol is not part of the guideline's exception so we exclude them
data <- data %>%
mutate(gene_symbol = str_remove(gene_symbol, "^-"))
#check remaining possible misspelling
unique_symbols <- unique(data$gene_symbol[
!grepl("^[A-Za-z0-9]*$", data$gene_symbol) &
!is.na(data$gene_symbol)
])
unique_symbols
#checking which hypen are legitimate by comparing it to the reference
included_symbols <- unique_symbols[
unique_symbols %in% ref_genesymbol$`Marker Symbol`
]
included_symbols
#"Hbb-bh2","H2-M5","Krtap17-1","H2-Q10", and "Pphln1-ps1" are the only legitimate ones
#removing all illegitimate hyphens
data <- data %>%
mutate(
gene_symbol = if_else(
gene_symbol %in% included_symbols,
gene_symbol,
str_remove_all(gene_symbol, "-")
)
)
#check remaining misspelling
unique(data$gene_symbol[
!grepl("^[A-Za-z0-9]*$", data$gene_symbol) &
!is.na(data$gene_symbol)
]) #none
#check which lowercase are legitimate by comparing it to the reference
comparison <- data %>%
distinct(gene_symbol) %>%
filter(!gene_symbol %in% ref_genesymbol$`Marker Symbol`)
###still hundreds of non-uniform forms of misspelling
### cleaning proof to be too tiresome, will resolve to replacing all gene symbols based on MGI Accesion id
}
#import reference csv
references <- read.csv("./References/ref_parameter_groups.csv")
colnames(references)
#extract middle suffix and create a new column
data <- data %>%
mutate(suffix = str_extract(parameter_stable_id, "(?<=_)[^_]+"))
#join to the reference by suffix and create a new column for suffix_desc
data <- data %>%
left_join(references, by = c("suffix" = "suffixes")) %>%
rename("suffix_desc" = description)
data <-  data %>%
select(-X, -Link) %>%
relocate(suffix, suffix_desc, .after= parameter_stable_id)
#Grouping by suffix
data <- data %>%
mutate(
group = case_when(
# 1. Weight and body composition
suffix %in% c("OWT", "HWT", "020", "005", "DXA") ~
"Weight and body composition",
# 2. Brain, behaviour and neurological function
suffix %in% c(
"SLW", "LDT", "OFD", "007", "FEA", "HBD",
"TLS", "ROT", "ACS", "011", "ABR", "ECT",
"TFL", "012", "008", "CSD", "GRS", "009"
) ~ "Brain, behaviour and neurological function",
# 3. Imaging and morphology
suffix %in% c(
"EYE", "014", "013", "XRY", "006", "XMV",
"GEL", "GEM", "GEO", "GEP", "GPL", "GPM",
"GPO", "GPP", "001", "026", "ERG"
) ~ "Imaging and morphology",
# 4. Cardiovascular and respiratory function
suffix %in% c("ECH", "ECG", "LFO", "CHL") ~
"Cardiovascular and respiratory function",
# 5. Blood, clinical chemistry and metabolism
suffix %in% c(
"CBC", "025", "015", "HEM", "016", "PLC",
"INS", "IPG", "004", "003", "CAL", "021", "URI"
) ~ "Blood, clinical chemistry and metabolism",
# 6. Immune system and immunophenotyping
suffix %in% c(
"IMM", "MLN", "PBI", "BMI", "EEI",
"019", "ANA", "018", "023"
) ~ "Immune system and immunophenotyping",
# 7. Histopathology and Tissue Analysis
suffix %in% c("HIS", "PAT", "ALZ") ~
"Histopathology and Tissue Analysis",
# 8. Reproductive and developmental biology
suffix %in% c("FER", "VIA", "EVL", "EVM", "EVO", "EVP") ~
"Reproductive and developmental biology",
)
) %>%
relocate(group, .after = suffix_desc)
#Check grouping
data %>%
count(group, sort = TRUE)
#check any ungrouped data
data %>%
filter(is.na(group)) %>%
distinct(suffix, suffix_desc)
