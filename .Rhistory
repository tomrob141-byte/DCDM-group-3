View(disease)
#checking if human symbol is all uppercase and have no special character
all(disease$human_symbol == toupper(disease$human_symbol), na.rm = TRUE)
#checking if human symbol is all uppercase and have no special character
all(grepl("^[A-Z0-9]+$", data$column_name), na.rm = TRUE)
#checking if human symbol is all uppercase and have no special character
all(grepl("^[A-Z0-9]+$", disease$human_symbol), na.rm = TRUE)
#there are some that has, checking
# Has lowercase letters
unique(disease$human_symbol[grepl("[a-z]", disease$human_symbol)])
# Has special characters (anything that is not a letter or digit)
unique(disease$human_symbol[grepl("[^A-Za-z0-9]", disease$human_symbol)])
#check if hgnc_id follows the notation HGNC: numbers
all(grepl("^HGNC:.*[0-9]+$", disease$hgnc_id), na.rm = TRUE)
View(bespoke)
#Checking if id columns follow their conventions
all(grepl("^HGNC:.*[0-9]+$", disease$hgnc_id), na.rm = TRUE) #TRUE
all(grepl("^DOID:.*[0-9]+$", disease$do_id), na.rm = TRUE) #TRUE
all(grepl("^MGI:.*[0-9]+$", disease$mgi_id), na.rm = TRUE) #TRUE
#checking if mouse_symbol first letter is uppercased and have no special characters
all(grepl("^[A-Z][a-zA-Z0-9]*$", disease$mouse_symbol), na.rm = TRUE)
#there are some that had, checking
unique(disease$mouse_symbol[!grepl("^[A-Z][a-zA-Z0-9]*$", disease$mouse_symbol)])
which(disease$mouse_symbol == "a")
disease$mouse_symbol[1041,]
